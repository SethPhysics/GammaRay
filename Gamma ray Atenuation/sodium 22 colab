":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":576},"id":"e54a1d2f","executionInfo":{"status":"ok","timestamp":1791468921444,"user_tz":-60,"elapsed":696,"user":{"displayName":"Douglas Main","userId":"14913741709285532155"}},"outputId":"645f0fdb-cbdb-4fe2-dd29-db74ad9d3d29"},"source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","def read_spe_file(filepath):\n","    \"\"\"\n","    Parses an ORTEC .Spe ASCII text file.\n","    Looks for '$DATA:' and reads the channel counts.\n","    \"\"\"\n","    counts = []\n","    in_data_section = False\n","    start_channels = None\n","\n","    with open(filepath, 'r') as f:\n","        lines = f.readlines()\n","\n","    i = 0\n","    while i < len(lines):\n","        line = lines[i].strip()\n","        if line == \"$DATA:\":\n","            # Next line contains start and stop channels\n","            i += 1\n","            start_stop = lines[i].strip().split()\n","            start_chan = int(start_stop[0])\n","            end_chan = int(start_stop[1])\n","            num_channels = end_chan - start_chan + 1\n","\n","            # Read channel data\n","            for _ in range(num_channels):\n","                i += 1\n","                counts.append(int(lines[i].strip()))\n","            break\n","        i += 1\n","\n","    return np.array(counts)\n","\n","file_path_spe = '/content/file/MyDrive/2nd Year/Gamma ray Atenuation/Sodium22Spectra1.Spe'\n","\n","try:\n","    counts = read_spe_file(file_path_spe)\n","    channels = np.arange(len(counts))\n","\n","    plt.figure(figsize=(10, 6))\n","    plt.plot(channels, counts, label='Sodium-22 Spectrum (.Spe)', color='blue', drawstyle='steps-mid')\n","    plt.title('Gamma Ray Spectrum (Sodium-22 from .Spe File)')\n","    plt.xlabel('Channel')\n","    plt.ylabel('Counts')\n","    plt.grid(True, which='both', linestyle='--', alpha=0.5)\n","    plt.legend()\n","    plt.show()\n","\n","    print(f\"Successfully loaded {len(counts)} channels.\")\n","except Exception as e:\n","    print(f\"Error reading Spe file: {e}\")"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Successfully loaded 1024 channels.\n"]}]},{"cell_type":"code","source":["import struct\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","def read_ortec_chn(filepath):\n","    \"\"\"\n","    Parses an EG&G ORTEC / MAESTRO binary .chn spectrum file.\n","    Returns:\n","        channels (np.ndarray): Array of channel numbers.\n","        counts (np.ndarray): Measured count array per channel.\n","        meta (dict): Extracted spectrum header metadata.\n","    \"\"\"\n","    with open(filepath, 'rb') as f:\n","        header = f.read(32)\n","        if len(header) < 32:\n","            raise ValueError(\"Invalid .chn file: header is too short.\")\n","\n","        # Unpack binary header fields (from bytes 0 to 15)\n","        ftype, mca, segment, start_sec_20ms, real_time_20ms, live_time_20ms = struct.unpack('<hhhhII', header[:16])\n","\n","        # Correct ORTEC / MAESTRO format offsets:\n","        # Byte 28 (2 bytes): Start channel (often 0 or 1)\n","        # Byte 30 (2 bytes): Number of channels (e.g., 512, 1024, 2048, 8192)\n","        f.seek(28)\n","        start_channel_data = struct.unpack('<h', f.read(2))[0]\n","        num_channels = struct.unpack('<h', f.read(2))[0]\n","\n","        # Channel data starts at byte 32\n","        f.seek(32)\n","        raw_data = f.read(num_channels * 4)\n","        counts = np.array(struct.unpack(f'<{num_channels}i', raw_data), dtype=np.int32)\n","        channels = np.arange(start_channel_data, start_channel_data + num_channels)\n","\n","        meta = {\n","            \"ftype\": ftype,\n","            \"mca_detector_id\": mca,\n","            \"segment\": segment,\n","            \"real_time_sec\": real_time_20ms * 0.02,\n","            \"live_time_sec\": live_time_20ms * 0.02,\n","            \"start_channel\": start_channel_data,\n","            \"num_channels\": num_channels\n","        }\n","\n","    return channels, counts, meta\n","\n","# --- Load and plot your file ---\n","file_path_chn = '/content/file/MyDrive/2nd Year/Gamma ray Atenuation/CHN/sodium22nocopper.Chn'\n","\n","try:\n","    channels, counts, meta = read_ortec_chn(file_path_chn)\n","\n","    plt.figure(figsize=(10, 6))\n","    plt.plot(channels, counts, label='Sodium-22 Spectrum (.Chn)', color='red', drawstyle='steps-mid')\n","    plt.title('Gamma Ray Spectrum (Sodium-22 without Copper from .Chn File)')\n","    plt.xlabel('Channel')\n","    plt.ylabel('Counts')\n","    plt.grid(True, which='both', linestyle='--', alpha=0.5)\n","    plt.legend()\n","    plt.show()\n","\n","    print(f\"Successfully loaded {len(counts)} channels from the .Chn file.\")\n","    print(\"Metadata:\", meta)\n","except Exception as e:\n","    print(f\"Error reading Chn file: {e}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":424},"id":"AFjlaTUtSov7","executionInfo":{"status":"ok","timestamp":1791543377792,"user_tz":-60,"elapsed":222,"user":{"displayName":"Douglas Main","userId":"14913741709285532155"}},"outputId":"bcc1d9ab-8845-4b3d-9195-45b2ed3e1d07"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Successfully loaded 1024 channels from the .Chn file.\n","Metadata: {'ftype': -1, 'mca_detector_id': 1, 'segment': 1, 'real_time_sec': 180.06, 'live_time_sec': 180.0, 'start_channel': 0, 'num_channels': 1024}\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":399},"id":"850db9f8","executionInfo":{"status":"ok","timestamp":1791543936596,"user_tz":-60,"elapsed":319,"user":{"displayName":"Douglas Main","userId":"149137417