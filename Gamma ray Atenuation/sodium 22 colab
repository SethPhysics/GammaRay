annels <= PEAK_END)\n","            window_counts = counts[window_mask]\n","\n","            if len(window_counts) > 0:\n","                # Get the maximum count within this peak region\n","                max_peak_count = np.max(window_counts)\n","                max_peak_channel = channels[window_mask][np.argmax(window_counts)]\n","\n","                layers_list.append(layers)\n","                peak_counts.append(max_peak_count)\n","                print(f\"{layers} Copper Layers: Peak count = {max_peak_count} at Channel {max_peak_channel}\")\n","            else:\n","                print(f\"Warning: No data in specified window for {layers} layers.\")\n","        except Exception as e:\n","            print(f\"Error reading {filename}: {e}\")\n","\n","# Sort the results by layers for clean plotting\n","sorted_indices = np.argsort(layers_list)\n","x_layers = np.array(layers_list)[sorted_indices]\n","y_counts = np.array(peak_counts)[sorted_indices]\n","\n","# Convert layers to cumulative thickness in mm (each sheet is 1.625 mm thick)\n","x_thickness_mm = x_layers * 1.625\n","\n","# Plot the attenuation curve against cumulative thickness\n","plt.figure(figsize=(10, 6))\n","plt.plot(x_thickness_mm, y_counts, 'o-', color='crimson', linewidth=2, markersize=8, label='Measured Peak Counts')\n","plt.title('511 keV Gamma-Ray Attenuation vs. Cumulative Copper Shielding Thickness')\n","plt.xlabel('Cumulative Copper Thickness (mm)')\n","plt.ylabel('Peak Counts (511 keV)')\n","plt.grid(True, linestyle='--', alpha=0.6)\n","plt.legend()\n","plt.show()"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Analyzing spectra using peak search window: Channels 220 to 290\n","\n","1 Copper Layers: Peak count = 84 at Channel 256\n","2 Copper Layers: Peak count = 71 at Channel 252\n","3 Copper Layers: Peak count = 68 at Channel 259\n","4 Copper Layers: Peak count = 63 at Channel 252\n","6 Copper Layers: Peak count = 54 at Channel 257\n","7 Copper La